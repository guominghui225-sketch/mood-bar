# Mood Bar 服务器环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ========================================
# 豆包API配置（必需）
# ========================================

# 从豆包开放平台获取：https://console.doubao.com/
DOUBAO_API_KEY=your_actual_doubao_api_key_here

# 豆包API端点（默认使用火山引擎API）
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包模型名称（默认使用doubao-seed-2.0-pro）
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

# ========================================
# 可灵API配置（可选，用于图像生成）
# ========================================

# 从可灵开放平台获取Access Key和Secret Key：https://platform.kling.ai/
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# 可灵API端点（北京区域）
KLING_API_URL=https://api-beijing.klingai.com/v1/images/generations

# 兼容旧版API Key格式（可选）
# KLING_API_KEY=your_kling_api_key_here

# ========================================
# 服务器配置
# ========================================

# 服务器端口
PORT=3007

# 运行环境：development | production
NODE_ENV=development

# ========================================
# CORS跨域配置
# ========================================

# 允许的前端地址，用逗号分隔
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3006,http://localhost:3007

# ========================================
# 缓存配置（可选）
# ========================================

# 是否启用缓存
CACHE_ENABLED=true

# 缓存存活时间（秒）
CACHE_TTL=3600

# ========================================
# 注意事项
# ========================================

# 1. 确保 .env 文件已添加到 .gitignore，不要提交到版本控制
# 2. 生产环境建议使用环境变量而非文件
# 3. 豆包API密钥是必需的，可灵API密钥是可选的
# 4. 如果没有可灵API密钥，系统将使用模拟图片URL
# 5. 端口3007是开发默认端口，生产环境可能需要调整