# Mood Bar 前端环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ========================================
# API配置
# ========================================

# 后端API基础URL（开发环境默认）
VITE_API_BASE_URL=http://localhost:3007

# 生产环境后端URL（部署后替换为实际URL）
# VITE_API_BASE_URL=https://your-api-domain.com

# ========================================
# 前端配置
# ========================================

# 可选的CDN路径前缀（生产环境）
# VITE_PUBLIC_PATH=/

# 应用名称（可选）
# VITE_APP_NAME=Mood Bar

# ========================================
# 调试配置
# ========================================

# 启用详细日志（开发环境）
# VITE_LOG_LEVEL=debug

# ========================================
# 注意事项
# ========================================

# 1. 确保 .env 文件已添加到 .gitignore，不要提交到版本控制
# 2. 生产环境部署时，通常在构建时注入环境变量
# 3. VITE_前缀的变量会被Vite暴露给客户端代码
# 4. 修改环境变量后需要重启开发服务器