{
  "name": "mood-bar-fullstack",
  "version": "1.0.0",
  "description": "Mood Bar - 情绪特调鸡尾酒生成器 (全栈Vercel部署)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd app && npm run dev",
    "dev:backend": "cd server && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd app && npm run build",
    "start:backend": "cd server && npm start",
    "vercel-build": "npm run build:frontend"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}