{
  "buildCommand": "cd app && npm ci && npm run build",
  "outputDirectory": "app/dist",
  "framework": null,
  "installCommand": "cd server && npm ci --no-audit --no-fund && cd ../app && npm ci --no-audit --no-fund",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}